# Copy to .env and replace the passwords. Values are embedded in connection
# URLs, so stick to URL-safe characters (letters, digits, - _ .) or URL-encode.
POSTGRES_DB=matchlens
POSTGRES_USER=matchlens
POSTGRES_PASSWORD=change-me-owner
MATCHLENS_RO_USER=matchlens_ro
MATCHLENS_RO_PASSWORD=change-me-readonly

POSTGRES_PORT=5432
API_PORT=8000
LOG_LEVEL=INFO

# Import guard rails: the loader refuses a snapshot that doesn't match these.
MATCHLENS_EXPECTED_MATCHES=38
MATCHLENS_EXPECTED_SHOTS=1086
